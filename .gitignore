.vscode/
.idea/
*.swp
*.swo
*~
*.bak
.clangd/
.cache/

# Python Cache & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.pytest_cache/

# OS-Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Rust build output
/target/

# AI assistant and agent state (never part of the repo)

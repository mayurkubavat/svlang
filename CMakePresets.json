{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "oracles",
      "displayName": "Slang compiler differential oracles (Release, Ninja)",
      "description": "Optional dev-only Slang dumpers in tools/oracles/ for differential compiler gates (tools/gates/). Not required to build or run svlang.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "oracles",
      "configurePreset": "oracles"
    }
  ]
}

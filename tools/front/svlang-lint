#!/bin/sh
# svlang-lint on the native engine (dv-lint, no Slang), with the Slang-backed
# C++ binary as the fallback for what dv-lint does not do yet.
#
#     tools/front/svlang-lint [svlang-lint options] <compile options> FILE...
#
# Runs target/release/dv-lint (the same program releases ship as `svlang-lint`)
# when every option is one it takes, else
# the C++ svlang-lint (build/svlang-lint, or $SVLANG_LINT_SLANG) with the same
# arguments, saying so on stderr. SVLANG_LINT_ENGINE=slang always uses the C++
# binary; SVLANG_LINT_ENGINE=native never falls back. Build the native engine
# with `cargo build --release -p dv-lint`.
repo=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
native=${SVLANG_LINT_NATIVE:-$repo/target/release/dv-lint}
slang=${SVLANG_LINT_SLANG:-$repo/build/svlang-lint}

engine=${SVLANG_LINT_ENGINE:-auto}
if [ "$engine" = auto ]; then
    engine=native
    expect_value=no
    for a in "$@"; do
        if [ "$expect_value" = yes ]; then
            expect_value=no
            continue
        fi
        case "$a" in
            # Options dv-lint takes, and those that take a value.
            --rule|--preset|--guideline|--dump-config|--library|--exclude|--compat-profile|--engine|--json|--config|--waivers|--baseline|--update-baseline|--sarif|--html|-top|--top|-I|-i|-D|-f|-F|-v|-y|-P|-l|-o|--timescale|-timescale|-incdir|-define|-undefine|-libext|-uvmhome|--uvmhome|-ntb_opts|--ntb_opts|-G|--param)
                expect_value=yes ;;
            --rule=*|--preset=*|--guideline=*|--dump-config=*|--library=*|--exclude=*|--compat-profile=*|--engine=*|--json=*|--config=*|--waivers=*|--baseline=*|--update-baseline=*|--sarif=*|--html=*|--param=*|-timescale=*|--conformance|--profile-rules|--experimental|--no-config|--no-cache|--history|--skip-libraries|--time|--frames|--no-frames|--in-context|--list|--list-rules|--list-guidelines|--lsp|--report-library|--single-unit|--separate-units|-uvm|--uvm|-h|--help|--version)
                ;;
            # --explain, --changed-since, waiver hygiene, the cache, --map,
            # --init, --python-rules.
            --explain|--changed-since|--cache-dir|--map|--python-rules)
                expect_value=yes ;;
            --explain=*|--changed-since=*|--cache-dir=*|--map=*|--python-rules=*|--strict-new-files|--waiver-report|--report-unused-waivers|--strict-waivers|--clear-cache|--init)
                ;;
            # Fix-its. Native fixes match the C++ engine on the corpus;
            # dv-lint holds back a file only for errors its own front end
            # finds, so it can still edit a file Slang would reject.
            --fix-rule)
                expect_value=yes ;;
            --fix|--fix-dry-run|--unsafe-fixes|--fix-rule=*)
                ;;
            +incdir+*|+define+*|+undefine+*|+libext+*|-I*|-D*|-G*|-pvalue+*)
                ;;
            -*) engine=slang; why=$a; break ;;
        esac
    done
fi
if [ "$engine" = native ] && [ ! -x "$native" ]; then
    echo "svlang-lint: $native is not built (cargo build --release -p dv-lint); using the Slang engine" >&2
    engine=slang
fi
if [ "$engine" = slang ]; then
    [ -n "${why-}" ] && echo "svlang-lint: '$why' needs the Slang engine; running $slang" >&2
    exec "$slang" "$@"
fi
case " $* " in
    *" --cache-dir "*|*" --cache-dir="*|*" --no-cache "*) ;;
    *)
        if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            exec "$native" --cache-dir "${XDG_CACHE_HOME:-$HOME/.cache}/svlang-lint" "$@"
        fi
        ;;
esac
exec "$native" "$@"
